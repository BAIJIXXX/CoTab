<Window x:Class="CoTab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoTab 便签板"
        Width="424" Height="624"
        MinWidth="360" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Topmost="True" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Language="zh-CN" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing" DpiChanged="Window_DpiChanged"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="SettingsSectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#8E9099" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#92939B" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F2F2F5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsDivider" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#1BFFFFFF" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
        <Style x:Key="SettingsSecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="ModeCardStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#E8E8EC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Card" CornerRadius="8" Background="#10FFFFFF" BorderBrush="#20FFFFFF"
                                BorderThickness="1" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#14FFD66B" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#FFD66B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBg" Background="#33000000" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#55000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PanelScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#1A1B1F" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBg" Background="#55FFFFFF" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#7AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#8CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Background="{x:Null}" PreviewMouseLeftButtonDown="WindowRoot_PreviewMouseLeftButtonDown">
        <Grid x:Name="PanelContainer" Margin="16">
            <Border x:Name="ShadowLayer" CornerRadius="8" Background="#FFFFFF">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="2" Direction="270" Opacity="0.85" Color="#000000" />
                </Border.Effect>
            </Border>

            <Border x:Name="PanelBase" CornerRadius="8" Background="#D1FFFFFF" />
            <Border x:Name="ImageLayer" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="PatternLayer" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="PanelEdge" CornerRadius="8" BorderThickness="1" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource PanelBorderBrush}" />

            <Grid x:Name="ContentRoot" Margin="12">
                <Canvas x:Name="NotesCanvas" Background="Transparent" ClipToBounds="True" />

                <Grid x:Name="MultiBoardLayer" Visibility="Collapsed">
                    <Grid x:Name="BoardHome" Margin="0,44,0,44">
                        <ScrollViewer x:Name="BoardsScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PanelScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <WrapPanel x:Name="BoardsPanel" />
                        </ScrollViewer>
                        <StackPanel x:Name="BoardHomeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Opacity="0.66">
                            <Border x:Name="BoardHomeEmptyGlyph" Width="54" Height="44" CornerRadius="7" BorderThickness="1.2"
                                    BorderBrush="#66000000" HorizontalAlignment="Center">
                                <UniformGrid Columns="2" Rows="2" Margin="7">
                                    <Border CornerRadius="1.5" Background="#55FFF1B8" Margin="1" />
                                    <Border CornerRadius="1.5" Background="#55FFD66B" Margin="1" />
                                    <Border CornerRadius="1.5" Background="#55FFD66B" Margin="1" />
                                    <Border CornerRadius="1.5" Background="#55FFF1B8" Margin="1" />
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="BoardHomeEmptyTitle" Text="还没有子板" HorizontalAlignment="Center" FontSize="12.5"
                                       FontWeight="SemiBold" Margin="0,11,0,0" Foreground="#3B3C42" />
                            <TextBlock x:Name="BoardHomeEmptySub" Text="点击右下角 ＋ 新建一个分类板块" HorizontalAlignment="Center"
                                       FontSize="11" Margin="0,5,0,0" Foreground="#8A8C94" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="BoardView" Visibility="Collapsed" Margin="2,44,2,44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="BoardsRailScroll" Width="76" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PanelScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel x:Name="BoardsRailPanel" />
                        </ScrollViewer>
                        <Border x:Name="BoardSurface" Grid.Column="1" CornerRadius="10" BorderThickness="1"
                                Background="#E6E9E3" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="BoardSurfaceHeader" Margin="12,0,10,0">
                                    <TextBlock x:Name="BoardTitleText" Text="板块" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Cursor="Hand" ToolTip="双击重命名"
                                               MouseLeftButtonDown="BoardTitleText_MouseLeftButtonDown" />
                                    <TextBlock x:Name="BoardNoteCountText" Text="" FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Opacity="0.66" />
                                </Grid>
                                <Canvas x:Name="BoardNotesCanvas" Grid.Row="1" Margin="10,0,10,10"
                                        Background="Transparent" ClipToBounds="True" />
                                <StackPanel x:Name="BoardEmptyHint" Grid.Row="1" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.62">
                                    <TextBlock x:Name="BoardEmptyTitle" Text="这个板块还没有便签" HorizontalAlignment="Center"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#3B3C42" />
                                    <TextBlock x:Name="BoardEmptySub" Text="点击右下角 ＋ 新增便签" HorizontalAlignment="Center"
                                               FontSize="11" Margin="0,5,0,0" Foreground="#8A8C94" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False" Opacity="0.62">
                    <Path x:Name="EmptyHintGlyph" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"
                          Data="M5,3 H19 A2,2 0 0 1 21,5 V17 A2,2 0 0 1 19,19 H9 L4,22 V5 A2,2 0 0 1 5,3 Z"
                          StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock x:Name="EmptyHintTitle" Text="便签板是空的" HorizontalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" Margin="0,11,0,0" />
                    <TextBlock x:Name="EmptyHintSub" Text="点击右下角 ＋ 写点什么" HorizontalAlignment="Center"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>

                <Grid x:Name="TopBar" Height="44" VerticalAlignment="Top">
                    <Border x:Name="TitleDragSurface" Background="Transparent"
                            MouseLeftButtonDown="TitleDragSurface_MouseLeftButtonDown" />
                    <StackPanel x:Name="TopLeftControls" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed"
                                Margin="0,0,2,0" ToolTip="返回主页" Click="BackButton_Click">
                            <Path x:Name="BackGlyph" Width="14" Height="14" Stretch="Uniform" Stroke="#3B3C42"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11,2 L4,8 L11,14 M4,8 H15" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Center" ToolTip="设置" Click="SettingsButton_Click">
                            <Path x:Name="SettingsGlyph" Width="16" Height="16" Stretch="Uniform" Fill="#3B3C42"
                                  Data="M12,1.8 L14.1,4.1 L17.2,3.5 L18.3,6.4 L21.2,7.6 L20.7,10.7 L23,12.8 L20.7,14.9 L21.2,18 L18.3,19.2 L17.2,22.1 L14.1,21.5 L12,23.8 L9.9,21.5 L6.8,22.1 L5.7,19.2 L2.8,18 L3.3,14.9 L1,12.8 L3.3,10.7 L2.8,7.6 L5.7,6.4 L6.8,3.5 L9.9,4.1 Z M12,7.6 A5.2,5.2 0 1 0 12,18 A5.2,5.2 0 1 0 12,7.6 Z" />
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="TopRightControls" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButtonStyle}"
                                Visibility="Collapsed" Margin="0,0,2,0" ToolTip="显示/隐藏其他板块"
                                Click="SidebarToggleButton_Click">
                            <Path x:Name="SidebarGlyph" Width="14" Height="14" Stretch="Uniform" Fill="Transparent"
                                  Stroke="#3B3C42" StrokeThickness="1.3"
                                  Data="M1.5,3 H14.5 V15 H1.5 Z M5.5,3 V15" />
                        </Button>
                        <Button x:Name="AutoHideButton" Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,2,0" ToolTip="自动收起" Click="AutoHideButton_Click">
                            <Path x:Name="AutoHideGlyph" Width="12" Height="10.4" Stretch="Fill"
                                  Fill="#3B3C42"
                                  Data="M4.2,3.4 L11.8,3.4 A2.2,2.2 0 0 1 12.9,5.306 L9.1,11.894 A2.2,2.2 0 0 1 6.9,11.894 L3.1,5.306 A2.2,2.2 0 0 1 4.2,3.4 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="AutoHideGlyphRotation" />
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}"
                                Margin="0,0,2,0" ToolTip="保持置顶" Click="PinButton_Click">
                            <Path x:Name="PinGlyph" Width="14" Height="14" Stretch="Uniform"
                                  Fill="#3B3C42"
                                  Data="M16,9 V4 H17 V2 H7 V4 H8 V9 L6,11 V13 H11 V22 H13 V13 H18 V11 Z" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Center" ToolTip="关闭"
                                Click="CloseButton_Click">
                            <Path x:Name="CloseGlyph" Width="13" Height="13" Stretch="Uniform" Stroke="#3B3C42"
                                  StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,2 L12,12 M12,2 L2,12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="BottomBar" Height="44" VerticalAlignment="Bottom">
                    <Border x:Name="TrashZone" Width="104" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource TrashIdleBrush}" CornerRadius="6" BorderThickness="1"
                            BorderBrush="#00FFFFFF" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="TrashGlyph" Width="13" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,3 H12 M5,3 V1.6 H9 V3 M3.4,3 L4.2,13.4 H9.8 L10.6,3 M6,6 V10.8 M8,6 V10.8" />
                            <TextBlock x:Name="TrashLabel" Text="拖到此处删除" Margin="6,0,0,0" FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="AddNoteButton" Style="{StaticResource AddNoteButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="新建便签（Ctrl+N）"
                            Click="AddNoteButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AddNotePlus" Text="＋" FontSize="16" Foreground="#3B3C42" Margin="0,-1,0,0" />
                            <TextBlock x:Name="AddNoteText" Text="新增便签" FontSize="12" Foreground="#3B3C42" Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="SettingsOverlay" CornerRadius="8" Background="#FF18191D" Visibility="Collapsed"
                        BorderBrush="#18FFFFFF" BorderThickness="1">
                    <Border.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource DarkScrollBarStyle}" />
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,14,10">
                            <TextBlock Text="设置" Foreground="#F5F5F7" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="完成" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="SettingsDoneButton_Click" />
                        </Grid>
                        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                            <StackPanel Margin="18,0,14,18">
                                <TextBlock Text="模式" Style="{StaticResource SettingsSectionTitle}" />
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <RadioButton x:Name="ModeMinimalRadio" Tag="Minimal" GroupName="AppMode"
                                                 Style="{StaticResource ModeCardStyle}" Margin="0,0,4,0"
                                                 Checked="AppMode_Checked">
                                        <StackPanel>
                                            <Border Height="48" CornerRadius="5" Background="#18FFFFFF">
                                                <Grid Margin="6">
                                                    <Border Width="38" Height="27" CornerRadius="2" Background="#FFF1B8"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Border Width="20" Height="9" CornerRadius="2" Background="#33FFFFFF"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                    <Ellipse Width="8" Height="8" Fill="#FFD66B"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="极简模式" FontSize="11.5" Foreground="#F0F0F3" Margin="1,7,0,0" />
                                            <TextBlock Text="单面板便签" FontSize="10" Foreground="#92939B" Margin="1,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeMultiRadio" Tag="MultiBoard" GroupName="AppMode"
                                                 Style="{StaticResource ModeCardStyle}" Margin="4,0,0,0"
                                                 Checked="AppMode_Checked">
                                        <StackPanel>
                                            <Border Height="48" CornerRadius="5" Background="#18FFFFFF">
                                                <UniformGrid Columns="2" Rows="2" Margin="5">
                                                    <Border CornerRadius="2" Background="#E9E3D5" Margin="1.5" />
                                                    <Border CornerRadius="2" Background="#CFE3EE" Margin="1.5" />
                                                    <Border CornerRadius="2" Background="#EFD2C4" Margin="1.5" />
                                                    <Border CornerRadius="2" Background="#FFD66B" Margin="1.5" />
                                                </UniformGrid>
                                            </Border>
                                            <TextBlock Text="多板模式" FontSize="11.5" Foreground="#F0F0F3" Margin="1,7,0,0" />
                                            <TextBlock Text="子板分类" FontSize="10" Foreground="#92939B" Margin="1,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Text="外观" Style="{StaticResource SettingsSectionTitle}" />
                                <StackPanel x:Name="PanelColorRowHost" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="背景不透明度" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock x:Name="PanelOpacityValue" Text="82%" HorizontalAlignment="Right" Style="{StaticResource SettingsValue}" />
                                </Grid>
                                <Slider x:Name="PanelOpacitySlider" Style="{StaticResource SettingsSliderStyle}" Minimum="18" Maximum="100"
                                        Margin="0,4,0,0" ValueChanged="PanelOpacitySlider_ValueChanged" />
                                <TextBlock Text="背景样式" Style="{StaticResource SettingsLabel}" Margin="0,13,0,7" />
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="StyleBlankRadio" Content="空白" Tag="Blank" GroupName="PanelStyle"
                                                 Style="{StaticResource SegmentStyle}" Margin="0,0,4,0" Checked="BackgroundStyle_Checked" />
                                    <RadioButton x:Name="StyleDotsRadio" Content="点阵" Tag="Dots" GroupName="PanelStyle"
                                                 Style="{StaticResource SegmentStyle}" Margin="0,0,4,0" Checked="BackgroundStyle_Checked" />
                                    <RadioButton x:Name="StyleCrossRadio" Content="十字阵" Tag="Cross" GroupName="PanelStyle"
                                                 Style="{StaticResource SegmentStyle}" Margin="0,0,4,0" Checked="BackgroundStyle_Checked" />
                                    <RadioButton x:Name="StyleImageRadio" Content="图片" Tag="Image" GroupName="PanelStyle"
                                                 Style="{StaticResource SegmentStyle}" Margin="0" Checked="BackgroundStyle_Checked" />
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <Button x:Name="PickImageButton" Content="选择图片…" Style="{StaticResource SettingsSecondaryButton}"
                                            Click="PickImageButton_Click" />
                                    <Button x:Name="ExtractThemeButton" Content="提取主题色" Style="{StaticResource SettingsSecondaryButton}"
                                            Margin="6,0,0,0" Click="ExtractThemeButton_Click" />
                                    <Button x:Name="ClearImageButton" Content="移除" Style="{StaticResource SettingsSecondaryButton}"
                                            Margin="6,0,0,0" Click="ClearImageButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ImageNameText" Text="未选择图片" Style="{StaticResource SettingsCaption}"
                                           TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="图片不透明度" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock x:Name="ImageOpacityValue" Text="90%" HorizontalAlignment="Right" Style="{StaticResource SettingsValue}" />
                                </Grid>
                                <Slider x:Name="ImageOpacitySlider" Style="{StaticResource SettingsSliderStyle}" Minimum="15" Maximum="100"
                                        Margin="0,4,0,0" ValueChanged="ImageOpacitySlider_ValueChanged" />
                                <TextBlock Text="图标与文字颜色" Style="{StaticResource SettingsLabel}" Margin="0,14,0,7" />
                                <StackPanel x:Name="InkColorRowsHost" />
                                <Border Style="{StaticResource SettingsDivider}" />

                                <TextBlock Text="便签" Style="{StaticResource SettingsSectionTitle}" />
                                <TextBlock Text="新便签默认颜色（不影响已有便签）" Style="{StaticResource SettingsCaption}" Margin="0,0,0,7" />
                                <StackPanel x:Name="NoteColorRowsHost" />
                                <Border Style="{StaticResource SettingsDivider}" />

                                <TextBlock Text="行为" Style="{StaticResource SettingsSectionTitle}" />
                                <Grid Height="30">
                                    <TextBlock Text="贴近屏幕边缘时自动收起" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="AutoHideSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Checked="AutoHideSwitch_Changed" Unchecked="AutoHideSwitch_Changed" />
                                </Grid>
                                <Grid Height="34">
                                    <TextBlock Text="关闭按钮" Style="{StaticResource SettingsLabel}" ToolTip="点击右上角关闭按钮时的行为" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <RadioButton x:Name="CloseMinimizeRadio" Content="最小化到托盘" Style="{StaticResource SegmentStyle}"
                                                     GroupName="CloseAction" Tag="MinimizeToTray" Checked="CloseAction_Checked"
                                                     ToolTip="隐藏窗口，程序继续在系统托盘运行" />
                                        <RadioButton x:Name="CloseExitRadio" Content="退出程序" Style="{StaticResource SegmentStyle}"
                                                     GroupName="CloseAction" Tag="Exit" Checked="CloseAction_Checked"
                                                     ToolTip="保存便签并完全退出 CoTab" />
                                    </StackPanel>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="始终置顶" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="TopmostSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Checked="TopmostSwitch_Changed" Unchecked="TopmostSwitch_Changed" />
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="StartupSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed" />
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="显示垃圾桶区域" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="TrashSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Checked="TrashSwitch_Changed" Unchecked="TrashSwitch_Changed" />
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock x:Name="ConfirmDeleteLabel" Text="删除便签前询问" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="ConfirmDeleteSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Checked="ConfirmDeleteSwitch_Changed" Unchecked="ConfirmDeleteSwitch_Changed" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDivider}" />

                                <TextBlock Text="AI 助手" Style="{StaticResource SettingsSectionTitle}" />
                                <Grid Height="30">
                                    <TextBlock Text="启用 AI 辅助窗口" Style="{StaticResource SettingsLabel}" />
                                    <CheckBox x:Name="AiEnabledSwitch" Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Click="AiEnabledSwitch_Click" />
                                </Grid>
                                <Button x:Name="OpenAssistantButton" Content="打开 AI 助手" Style="{StaticResource SettingsSecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Click="OpenAssistantButton_Click" />
                                <TextBlock Text="API Key、模型和提示词在 AI 窗口右上角的“设置”页配置。AI 默认静默，只在你提问时工作。"
                                           Style="{StaticResource SettingsCaption}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Border Style="{StaticResource SettingsDivider}" />

                                <TextBlock Text="数据" Style="{StaticResource SettingsSectionTitle}" />
                                <Button Content="打开配置与背景图片文件夹" Style="{StaticResource SettingsSecondaryButton}"
                                        HorizontalAlignment="Left" Click="OpenDataFolderButton_Click" />
                                <TextBlock x:Name="AboutText" Text="CoTab 1.0 · 轻量桌面便签板" Style="{StaticResource SettingsCaption}"
                                           Margin="0,14,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="ConfirmOverlay" CornerRadius="8" Background="#66000000" Visibility="Collapsed">
                    <Border Width="268" Background="#FA1B1C21" CornerRadius="8" Padding="18,16" HorizontalAlignment="Center"
                            VerticalAlignment="Center" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmTitle" Text="删除这张便签？" Foreground="#F7F7F9" FontSize="13.5"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ConfirmMessage" Text="删除后无法恢复。" Foreground="#A0A1A9" FontSize="11"
                                       Margin="0,6,0,15" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Style="{StaticResource SettingsSecondaryButton}" Click="ConfirmCancel_Click" />
                                <Button Content="删除" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0"
                                        Background="#E8544A" Foreground="#FFFFFF" Click="ConfirmDelete_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,56"
                        Background="#E8202126" CornerRadius="6" Padding="12,7" Opacity="0" Visibility="Collapsed"
                        Cursor="Hand" MouseLeftButtonUp="ToastHost_MouseLeftButtonUp">
                    <TextBlock x:Name="ToastText" Text="" Foreground="#F4F4F6" FontSize="11.5" />
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="CollapsedTab" Visibility="Collapsed" CornerRadius="7"
                BorderThickness="1" Background="#F2FFFFFF" BorderBrush="#24000000" Cursor="Hand">
            <StackPanel x:Name="CollapsedDots" Orientation="Vertical"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="2.4" Height="2.4" Fill="#88000000" Margin="0,1.5" />
                <Ellipse Width="2.4" Height="2.4" Fill="#88000000" Margin="0,1.5" />
                <Ellipse Width="2.4" Height="2.4" Fill="#88000000" Margin="0,1.5" />
            </StackPanel>
        </Border>

        <Grid x:Name="ResizeLayer">
            <Border Height="20" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="Top" />
            <Border Height="20" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="Bottom" />
            <Border Width="20" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="Left" />
            <Border Width="20" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE"
                    MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="Right" />
            <Border Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNWSE" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="TopLeft" />
            <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNESW" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="TopRight" />
            <Border Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent"
                    Cursor="SizeNESW" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="BottomLeft" />
            <Border Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                    Cursor="SizeNWSE" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" Tag="BottomRight" />
        </Grid>
    </Grid>
</Window>

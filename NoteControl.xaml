<UserControl x:Class="CoTab.NoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="184" Height="184"
             FontFamily="Microsoft YaHei UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="NoteEditorStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CaretBrush" Value="#3D382B" />
            <Setter Property="SelectionBrush" Value="#553B6EA8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NoteScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBg" Background="#33000000" CornerRadius="2" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#55000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NoteScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NoteScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="NoteBody" CornerRadius="0" BorderThickness="1" BorderBrush="#26000000" Background="#FFF1B8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ContentScroll" Grid.Row="0" Margin="11,10,9,2"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource NoteScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <ContentControl x:Name="RenderedContent" Focusable="False" IsHitTestVisible="False"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyPlaceholder" Grid.Row="0" Margin="12,11,10,2" Text="点击输入…"
                           FontSize="12" Opacity="0.42" Foreground="#3D382B" IsHitTestVisible="False" />

                <TextBox x:Name="Editor" Grid.Row="0" Margin="11,9,9,2" Style="{StaticResource NoteEditorStyle}"
                         Visibility="Collapsed" TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"
                         LostKeyboardFocus="Editor_LostKeyboardFocus">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource NoteScrollBarStyle}" />
                    </TextBox.Resources>
                </TextBox>

                <Grid Grid.Row="1" Margin="11,0,8,0" IsHitTestVisible="False">
                    <TextBlock x:Name="ModeBadge" FontSize="9" Opacity="0.48" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="SizeBadge" FontSize="9" Opacity="0.40" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="SelectionRing" CornerRadius="0" BorderThickness="1.4" BorderBrush="#993B6EA8"
                IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />

        <Border x:Name="HoverRing" CornerRadius="0" BorderThickness="1" BorderBrush="#223B6EA8"
                IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" />

        <Border x:Name="ResizeCorner" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="SizeNWSE" ToolTip="拖动调整大小"
                MouseLeftButtonDown="ResizeCorner_MouseLeftButtonDown" MouseMove="ResizeCorner_MouseMove"
                MouseLeftButtonUp="ResizeCorner_MouseLeftButtonUp">
            <Path Data="M1 13 L13 1 M7 13 L13 7" Stroke="#553D382B" StrokeThickness="1.1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="12" Height="12" Stretch="Uniform" />
        </Border>
    </Grid>
</UserControl>

<Window x:Class="CoTab.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoTab AI 助手"
        Width="360" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="AiThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBg" Background="#55FFFFFF" CornerRadius="3" Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#7AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AiThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AiScrollBar}" />
        <Style x:Key="AiInput" TargetType="TextBox">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="#F2F3F6" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#FFD66B" />
            <Setter Property="SelectionBrush" Value="#66FFD66B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="Foreground" Value="#F2F3F6" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#FFD66B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B9BEC8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="AiCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7F8692" />
            <Setter Property="FontSize" Value="10.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AiSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F3F6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="AiChip" TargetType="Button">
            <Setter Property="Foreground" Value="#C7CCD6" />
            <Setter Property="FontSize" Value="10.8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AiTab" TargetType="RadioButton" BasedOn="{StaticResource SegmentStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ShellBorder" Margin="10" CornerRadius="10" Background="#FA18191D" BorderBrush="#22FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#7BD88F" Margin="0,0,7,0" />
                        <TextBlock Text="AI 助手" Foreground="#F4F5F8" FontSize="12.5" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button x:Name="CollapseButton" Width="26" Height="26" HorizontalAlignment="Right"
                            Style="{StaticResource IconButtonStyle}" Click="CollapseButton_Click" ToolTip="折叠 AI 窗口">
                        <Path Data="M9,4 L14,9 L9,14" Stroke="#AEB4C0" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="9" />
                    </Button>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="3" Margin="10,0,10,2">
                    <RadioButton x:Name="ChatTab" Content="对话" Style="{StaticResource AiTab}"
                                 GroupName="AiTabs" IsChecked="True" Tag="0" Checked="Tab_Checked" />
                    <RadioButton x:Name="ScheduleTab" Content="日程" Style="{StaticResource AiTab}"
                                 GroupName="AiTabs" Tag="1" Checked="Tab_Checked" />
                    <RadioButton x:Name="SettingsTab" Content="设置" Style="{StaticResource AiTab}"
                                 GroupName="AiTabs" Tag="2" Checked="Tab_Checked" />
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid x:Name="ChatView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                            <StackPanel x:Name="ChatPanel" Margin="12,4,12,6" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="12,0,12,12">
                            <WrapPanel x:Name="ChipsPanel" Orientation="Horizontal" />
                            <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Margin="0,2,0,0">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InputBox" Style="{StaticResource AiInput}" MinHeight="38" MaxHeight="106"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                             BorderThickness="0" Background="Transparent" KeyDown="InputBox_KeyDown"
                                             TextChanged="InputBox_TextChanged" />
                                    <TextBlock x:Name="InputPlaceholder" Text="问点什么…  Enter 发送，Shift+Enter 换行"
                                               Foreground="#737A86" FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Width="52" Height="30"
                                            Style="{StaticResource AccentButtonStyle}" Margin="6,0,0,0" Click="SendButton_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StatusText" Text="静默待命 · 只在提问时调用模型" Style="{StaticResource AiCaption}"
                                       Margin="2,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ScheduleView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,4,12,6">
                            <TextBlock Text="自动识别的日程" Foreground="#F2F3F6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="刷新" Width="48" Height="24" HorizontalAlignment="Right"
                                    Style="{StaticResource SettingsSecondaryButton}" Click="RefreshScheduleButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ScheduleListPanel" Margin="14,0,14,14" />
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,2,14,16">
                            <TextBlock Text="连接" Style="{StaticResource AiSection}" />
                            <TextBlock Text="API 地址（OpenAI 兼容）" Style="{StaticResource AiFieldLabel}" />
                            <TextBox x:Name="EndpointBox" Style="{StaticResource AiInput}" />
                            <TextBlock Text="API Key" Style="{StaticResource AiFieldLabel}" />
                            <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource AiPassword}" />
                            <TextBlock Text="模型" Style="{StaticResource AiFieldLabel}" />
                            <TextBox x:Name="ModelBox" Style="{StaticResource AiInput}" />
                            <TextBlock Text="系统提示词（可选，会叠加在内置指令之后）" Style="{StaticResource AiFieldLabel}" />
                            <TextBox x:Name="SystemPromptBox" Style="{StaticResource AiInput}" Height="72"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <Border Height="1" Background="#18FFFFFF" Margin="0,14,0,2" />
                            <TextBlock Text="自动化" Style="{StaticResource AiSection}" />
                            <Grid Height="30">
                                <TextBlock Text="自动识别便签中的日程" Foreground="#D8DCE4" FontSize="11.5" VerticalAlignment="Center" />
                                <CheckBox x:Name="AutoScheduleSwitch" Style="{StaticResource SwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Height="30">
                                <TextBlock Text="日程变化时在对话中给出建议" Foreground="#D8DCE4" FontSize="11.5" VerticalAlignment="Center" />
                                <CheckBox x:Name="AutoSuggestionSwitch" Style="{StaticResource SwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="提前提醒" Style="{StaticResource AiFieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ReminderBox" Style="{StaticResource AiInput}" Width="64" />
                                <TextBlock Text="分钟" Foreground="#8F96A2" FontSize="11.5" VerticalAlignment="Center" Margin="7,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存设置" Width="82" Height="28" Style="{StaticResource AccentButtonStyle}"
                                        Click="SaveSettingsButton_Click" />
                                <Button Content="测试连接" Width="82" Height="28" Style="{StaticResource SettingsSecondaryButton}"
                                        Margin="8,0,0,0" Click="TestButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsStatusText" Style="{StaticResource AiCaption}" Margin="0,8,0,0" />
                            <TextBlock Text="API Key 只保存在本机 state.json，不会上传到 CoTab。AI 请求会直接发往你填写的 API 地址。"
                                       Style="{StaticResource AiCaption}" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="CollapsedTab" Margin="10" Visibility="Collapsed" Background="#FA18191D" BorderBrush="#22FFFFFF"
                BorderThickness="1" CornerRadius="8" MouseLeftButtonDown="CollapsedTab_MouseLeftButtonDown"
                Cursor="Hand" ToolTip="展开 AI 助手">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="AI" Foreground="#FFD66B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Ellipse Width="5" Height="5" Fill="#7BD88F" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

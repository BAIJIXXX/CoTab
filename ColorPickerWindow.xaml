<Window x:Class="CoTab.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色"
        Width="304"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PickerTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Foreground" Value="#F2F3F5" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PickerLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#B9BDC6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PickerButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#E8EAEE" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaletteSwatchStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="13" BorderBrush="Transparent" BorderThickness="1.2" Margin="1" />
                            <Ellipse x:Name="Dot" Width="17" Height="17" Fill="{TemplateBinding Background}"
                                     Stroke="#33FFFFFF" StrokeThickness="0.6" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#CCFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#9A9EA7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#FA17181C" CornerRadius="10" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="18,14,18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid x:Name="HeaderRow" Background="Transparent" Margin="0,0,0,12" MouseLeftButtonDown="HeaderRow_MouseLeftButtonDown">
                <TextBlock Text="选择颜色" Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource PickerCloseButton}" HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <Border x:Name="PreviewBorder" Height="36" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1" />
            <TextBlock x:Name="PreviewHexText" Margin="0,6,0,0" FontSize="10.5" Foreground="#8E93A0" HorizontalAlignment="Center" />

            <Grid Margin="0,12,0,0">
                <TextBlock Text="十六进制" Style="{StaticResource PickerLabel}" />
                <TextBox x:Name="HexBox" Style="{StaticResource PickerTextBox}" Width="96" HorizontalAlignment="Right"
                         TextChanged="HexBox_TextChanged" />
            </Grid>

            <Grid Margin="0,9,0,0">
                <TextBlock Text="红 R" Style="{StaticResource PickerLabel}" Width="38" />
                <Slider x:Name="RedSlider" Style="{StaticResource SettingsSliderStyle}" Maximum="255" Margin="38,0,38,0"
                        ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock x:Name="RedValue" Text="0" Style="{StaticResource PickerLabel}" Width="30" HorizontalAlignment="Right" TextAlignment="Right" />
            </Grid>
            <Grid Margin="0,5,0,0">
                <TextBlock Text="绿 G" Style="{StaticResource PickerLabel}" Width="38" />
                <Slider x:Name="GreenSlider" Style="{StaticResource SettingsSliderStyle}" Maximum="255" Margin="38,0,38,0"
                        ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock x:Name="GreenValue" Text="0" Style="{StaticResource PickerLabel}" Width="30" HorizontalAlignment="Right" TextAlignment="Right" />
            </Grid>
            <Grid Margin="0,5,0,0">
                <TextBlock Text="蓝 B" Style="{StaticResource PickerLabel}" Width="38" />
                <Slider x:Name="BlueSlider" Style="{StaticResource SettingsSliderStyle}" Maximum="255" Margin="38,0,38,0"
                        ValueChanged="RgbSlider_ValueChanged" />
                <TextBlock x:Name="BlueValue" Text="0" Style="{StaticResource PickerLabel}" Width="30" HorizontalAlignment="Right" TextAlignment="Right" />
            </Grid>

            <TextBlock Text="常用颜色" Style="{StaticResource PickerLabel}" Margin="0,14,0,7" />
            <UniformGrid x:Name="PaletteGrid" Columns="9" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource PickerButton}" IsCancel="True" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Width="68" Margin="8,0,0,0"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CoTab</AssemblyName>
    <RootNamespace>CoTab</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- WPF owns DPI awareness via app.manifest; WinForms is only used for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Uncompressed-DIB ICO for the notification area: some Windows shells do
         not render PNG-compressed 16px entries and the tray icon becomes blank. -->
    <Resource Include="Assets\tray.ico" />
    <EmbeddedResource Include="Assets\assistant-avatar.png" LogicalName="CoTab.AssistantAvatar.png" />
  </ItemGroup>

</Project>
